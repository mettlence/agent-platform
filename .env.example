NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster/?retryWrites=true
MONGODB_DB=agent_platform

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# Discord
DISCORD_BOT_TOKEN=...
# CSV of guild (server) IDs the bot will respond in (single ID also valid)
DISCORD_GUILD_IDS=...
# CSV of channel IDs the bot will respond in (single ID also valid)
DISCORD_CS_CHANNEL_IDS=...
# Optional: CSV of channel IDs where @bot monitor posts reports inline (no
# thread). Must be a subset of DISCORD_CS_CHANNEL_IDS. Leave blank to keep
# every channel in threaded mode.
DISCORD_MONITOR_CHANNEL_IDS=
DISCORD_CS_LEAD_ROLE_ID=...
# Optional: CSV of BOT user IDs allowed to hand tickets over by mentioning the
# agent (e.g. Tala, the LiveAgent CS bot). Blank = ignore every bot, which is
# the historical behaviour. Never put this bot's own ID here.
DISCORD_ALLOWED_BOT_IDS=
# Optional: Discord user ID that approves bot-relayed tickets over DM. Set it
# TOGETHER with DISCORD_ALLOWED_BOT_IDS — the DM route needs both, and with
# either missing every ticket keeps approving in-thread as before.
# The approver must share a server with the bot AND have "Allow direct
# messages from server members" enabled, or the DM bounces (error 50007) and
# the draft falls back to the thread.
DISCORD_APPROVER_USER_ID=

# ClickBank (single key — dev key deprecated 2023-07-27)
# Format: API-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CLICKBANK_API_KEY=API-...

# AskSabrina agent API (existing)
ASKSABRINA_API_BASE=https://api.asksabrina.com/api/agent
ASKSABRINA_AGENT_KEY=...

# AstroLoverSketch agent API (future — leave blank for MVP)
ASTROLOVERSKETCH_API_BASE=
ASTROLOVERSKETCH_AGENT_KEY=
